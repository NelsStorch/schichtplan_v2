---
/** Klickweg in der App: <Path steps={['Anlass', 'OK-Dashboard', 'Zugang & Angaben']} /> */
import ChevronRight from '@lucide/astro/icons/chevron-right';
import MousePointerClick from '@lucide/astro/icons/mouse-pointer-click';

interface Props {
  steps: string[];
}
const { steps } = Astro.props;
---

<p class="path not-content">
  <span class="path-icon" aria-hidden="true"><MousePointerClick size={15} strokeWidth={2} /></span>
  <span class="sr-only">Klickweg:</span>
  {
    steps.map((step, i) => (
      <>
        {i > 0 && (
          <span class="path-sep" aria-hidden="true">
            <ChevronRight size={14} strokeWidth={2.2} />
          </span>
        )}
        <span class:list={['path-step', { 'path-step--last': i === steps.length - 1 }]}>{step}</span>
      </>
    ))
  }
</p>

<style>
  .path {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    width: fit-content;
    max-width: 100%;
    margin-block: 1rem;
    padding: 0.4375rem 0.875rem 0.4375rem 0.4375rem;
    border-radius: 999px;
    border: 1px solid rgb(var(--line));
    background: rgb(var(--surface-2) / 0.7);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .path-icon {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    background: rgb(var(--accent) / 0.12);
    color: rgb(var(--accent-ink));
  }

  .path-step {
    font-weight: 600;
    color: rgb(var(--fg-muted));
  }

  .path-step--last {
    color: rgb(var(--fg));
  }

  .path-sep {
    display: inline-flex;
    color: rgb(var(--fg-subtle));
  }
</style>
