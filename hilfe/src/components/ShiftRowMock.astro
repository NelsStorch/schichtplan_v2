---
/**
 * Nachbau einer Schicht-Zeile aus der Listenansicht, mit beschrifteten Stellen.
 * Bewusst kein Screenshot: bleibt scharf, passt sich Hell/Dunkel an und veraltet langsamer.
 */
import Plus from '@lucide/astro/icons/plus';
---

<figure class="mock not-content">
  <div class="mock-frame">
    <div class="mock-day">
      <span class="mock-weekday">Samstag</span>
      <span class="mock-date">27. Juni</span>
      <span class="mock-daypill">5 frei · 11/16</span>
    </div>
    <div class="mock-row">
      <div class="mock-time">
        <b>17:00</b>
        <span>20:00</span>
        <i class="mock-pin mock-pin--1">1</i>
      </div>
      <div class="mock-main">
        <div class="mock-title">
          Grill &amp; Bar <span class="mock-badge">ab 16</span>
          <i class="mock-pin mock-pin--2">2</i>
        </div>
        <ul class="mock-tasks">
          <li class="is-open">Grill <b>1/2</b></li>
          <li class="is-full">Bar <b>2/2</b></li>
          <li class="is-open">Kasse <b>0/1</b><i class="mock-pin mock-pin--3">3</i></li>
        </ul>
        <div class="mock-bar"><span style="width: 60%"></span></div>
      </div>
      <div class="mock-side">
        <span class="mock-free">2 frei</span>
        <span class="mock-btn"><Plus size={14} strokeWidth={2.4} /> Eintragen</span>
        <i class="mock-pin mock-pin--4">4</i>
      </div>
    </div>
  </div>
  <figcaption>
    <ol>
      <li><b>Zeit</b> von bis. Schichten sind nach Tag sortiert.</li>
      <li><b>Titel</b> der Schicht. «ab 16» heisst Mindestalter 16.</li>
      <li><b>Arbeiten</b> in der Schicht mit Belegung. Grau ist voll.</li>
      <li><b>Freie Plätze</b> und der Knopf zum Eintragen.</li>
    </ol>
  </figcaption>
</figure>

<style>
  .mock {
    margin-block: 1.75rem;
  }

  .mock-frame {
    padding: 1.25rem;
    border-radius: var(--radius-card);
    border: 1px solid rgb(var(--line));
    background:
      radial-gradient(80% 120% at 100% 0%, rgb(var(--accent) / 0.07), transparent 60%),
      rgb(var(--surface-2) / 0.6);
  }

  .mock-day {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    margin-bottom: 0.75rem;
  }

  .mock-weekday {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: rgb(var(--fg));
  }

  .mock-date {
    font-size: 0.8125rem;
    font-weight: 600;
    color: rgb(var(--fg-subtle));
  }

  .mock-daypill {
    margin-left: auto;
    padding: 0.1875rem 0.625rem;
    border-radius: 999px;
    background: rgb(var(--accent) / 0.1);
    color: rgb(var(--accent-ink));
    font-family: var(--__sl-font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .mock-row {
    display: flex;
    gap: 0.875rem;
    padding: 0.875rem 1rem;
    border-radius: 1.125rem;
    border: 1px solid rgb(var(--line));
    background: rgb(var(--surface));
    box-shadow: var(--shadow-soft);
  }

  .mock-time {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 3rem;
    flex-shrink: 0;
    font-family: var(--__sl-font-mono);
    font-size: 0.75rem;
    color: rgb(var(--fg-subtle));
  }

  .mock-time b {
    font-size: 0.9375rem;
    color: rgb(var(--fg));
  }

  .mock-main {
    flex: 1;
    min-width: 0;
  }

  .mock-title {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.4375rem;
    font-size: 0.9375rem;
    font-weight: 650;
    color: rgb(var(--fg));
  }

  .mock-badge {
    padding: 0.0625rem 0.4375rem;
    border-radius: 999px;
    background: rgb(var(--ember) / 0.14);
    color: rgb(var(--ember-ink));
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .mock-tasks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .mock-tasks li {
    position: relative;
    margin: 0;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 550;
  }

  .mock-tasks .is-open {
    background: rgb(var(--accent) / 0.1);
    color: rgb(var(--accent-ink));
  }

  .mock-tasks .is-full {
    background: rgb(var(--surface-2));
    color: rgb(var(--fg-subtle));
  }

  .mock-bar {
    height: 0.375rem;
    margin-top: 0.75rem;
    border-radius: 999px;
    background: rgb(var(--surface-3));
    overflow: hidden;
  }

  .mock-bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: rgb(var(--accent));
  }

  .mock-side {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .mock-free {
    font-family: var(--__sl-font-mono);
    font-size: 0.8125rem;
    font-weight: 700;
    color: rgb(var(--accent-ink));
  }

  .mock-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3125rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgb(var(--line-strong));
    font-size: 0.75rem;
    font-weight: 650;
    color: rgb(var(--fg));
    white-space: nowrap;
  }

  .mock-pin {
    position: absolute;
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 999px;
    background: rgb(var(--fg));
    color: rgb(var(--canvas));
    font-family: var(--__sl-font-mono);
    font-size: 0.625rem;
    font-style: normal;
    font-weight: 700;
    box-shadow: 0 0 0 3px rgb(var(--surface));
  }

  .mock-pin--1 {
    top: -0.875rem;
    left: -0.5rem;
  }
  .mock-pin--2 {
    position: static;
    margin-left: 0.125rem;
  }
  .mock-pin--3 {
    top: -0.625rem;
    right: -0.625rem;
  }
  .mock-pin--4 {
    top: -0.875rem;
    right: -0.75rem;
  }

  figcaption ol {
    display: grid;
    gap: 0.375rem 1.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: pin;
    font-size: 0.875rem;
    color: rgb(var(--fg-muted));
  }

  figcaption li {
    counter-increment: pin;
    display: flex;
    gap: 0.5rem;
    margin: 0;
  }

  figcaption li::before {
    content: counter(pin);
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.125rem;
    border-radius: 999px;
    background: rgb(var(--fg));
    color: rgb(var(--canvas));
    font-family: var(--__sl-font-mono);
    font-size: 0.625rem;
    font-weight: 700;
  }

  figcaption b {
    color: rgb(var(--fg));
  }

  @media (min-width: 40rem) {
    figcaption ol {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
