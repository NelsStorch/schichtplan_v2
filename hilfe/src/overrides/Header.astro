---
// Schwebende Glas-Pille wie auf cevi-schichtplan.ch: Titel, Suche, Link zur App, Hell/Dunkel.
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
---

<div class="hx">
  <div class="hx-title">
    <SiteTitle />
  </div>
  <div class="hx-search print:hidden">
    <Search />
  </div>
  <div class="hx-right print:hidden">
    <a class="hx-app" href="https://cevi-schichtplan.ch">
      <span>Zum Schichtplan</span>
      <ArrowUpRight size={15} strokeWidth={2} aria-hidden="true" />
    </a>
    <ThemeSelect />
  </div>
</div>

<style>
  .hx {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 100%;
    max-height: 3.5rem;
    padding: 0.375rem 0.375rem 0.375rem 0.875rem;
    border-radius: 999px;
    border: 1px solid rgb(var(--line) / 0.9);
    background: rgb(var(--glass) / 0.8);
    backdrop-filter: blur(20px) saturate(1.5);
    -webkit-backdrop-filter: blur(20px) saturate(1.5);
    box-shadow: var(--shadow-soft);
  }

  .hx-title {
    min-width: 0;
    flex-shrink: 1;
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
  }

  .hx-search {
    display: flex;
    flex: 1;
    justify-content: flex-end;
  }

  .hx-right {
    display: none;
    align-items: center;
    gap: 0.375rem;
  }

  .hx-app {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 2.75rem;
    padding-inline: 1.125rem 0.875rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 650;
    text-decoration: none;
    color: rgb(var(--accent-fg));
    background: rgb(var(--accent));
    box-shadow: 0 8px 24px -10px rgb(var(--accent) / 0.75);
    transition:
      filter 0.2s ease,
      transform 0.2s ease;
  }

  .hx-app:hover {
    filter: brightness(1.08);
  }

  .hx-app:active {
    transform: scale(0.97);
  }

  @media (min-width: 50rem) {
    .hx {
      max-width: 82rem;
      margin-inline: auto;
      gap: 1.25rem;
      padding-inline-start: 1.125rem;
    }

    .hx-search {
      justify-content: center;
    }

    .hx-search :global(site-search) {
      width: 100%;
      max-width: 26rem;
    }

    .hx-right {
      display: flex;
    }
  }
</style>
