---
// Schwebende Glas-Pille wie auf cevi-schichtplan.ch: Titel, Suche, Link zur App, Hell/Dunkel.
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
---

<div class="hx">
  <div class="hx-title">
    <SiteTitle />
  </div>
  <div class="hx-search print:hidden">
    <Search />
  </div>
  <div class="hx-right print:hidden">
    <a class="hx-app" href="https://cevi-schichtplan.ch" data-app-link>
      <span data-app-label>Zum Schichtplan</span>
      <ArrowUpRight size={15} strokeWidth={2} aria-hidden="true" />
    </a>
    <ThemeSelect />
  </div>
</div>

<script>
  // Intelligenter Rücksprung: Merkt sich, von welcher Abteilung / Schar / welchem Verein der Besucher kam.
  // Gemerkt wird nur ein Ziel der eigenen Verbandsdomain. Sonst würde ein alter Rücksprung (z. B. von
  // einer Cevi-Seite) auf hilfe.pfadi-schichtplan.ch alle Links zurück auf Cevi umleiten.
  try {
    // Verbandsdomains aus branding.js (dort aus packages/shared/src/organizations.ts erzeugt)
    const orgs = (window as unknown as { SCHICHTPLAN_ORGS?: Record<string, { domain: string }> }).SCHICHTPLAN_ORGS ?? {};
    const validDomains = Object.values(orgs).map((o) => o.domain);
    const inDomain = (host: string, domain: string) => host === domain || host.endsWith(`.${domain}`);
    const currentHost = window.location.hostname.toLowerCase();
    const currentDomain = validDomains.find((d) => inDomain(currentHost, d)) ?? null;

    const accepted = (value: string | null): URL | null => {
      if (!value) return null;
      try {
        const url = new URL(value, window.location.origin);
        if (url.protocol !== 'https:' && url.protocol !== 'http:') return null;
        const host = url.hostname.toLowerCase();
        if (host.startsWith('hilfe.')) return null;
        if (currentDomain) return inDomain(host, currentDomain) ? url : null;
        return validDomains.some((d) => inDomain(host, d)) || host === 'localhost' || host.endsWith('.localhost')
          ? url
          : null;
      } catch {
        return null;
      }
    };

    const params = new URLSearchParams(window.location.search);
    let fromUrl = accepted(params.get('from'));
    if (!fromUrl && document.referrer) {
      const ref = accepted(document.referrer);
      if (ref) fromUrl = new URL(ref.origin);
    }

    if (fromUrl) {
      sessionStorage.setItem('schichtplan_return_url', fromUrl.href);
    }

    const stored = sessionStorage.getItem('schichtplan_return_url');
    const url = accepted(stored);
    if (stored && !url) sessionStorage.removeItem('schichtplan_return_url');

    if (url) {
      const hostParts = url.hostname.split('.');
      const sub = hostParts.length >= 3 ? hostParts[0] : null;

      document.querySelectorAll<HTMLAnchorElement>('[data-app-link]').forEach((a) => {
        a.href = url.href;
      });
      document.querySelectorAll('[data-app-label]').forEach((span) => {
        if (sub && sub !== 'www' && sub !== 'login') {
          span.textContent = `Zurück zu ${sub}`;
        } else {
          span.textContent = 'Zurück zum Schichtplan';
        }
      });
    }
  } catch {
    // Fehlerfrei weiterlaufen
  }
</script>

<style>
  .hx {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 100%;
    max-height: 3.5rem;
    padding: 0.375rem 0.375rem 0.375rem 0.875rem;
    border-radius: 999px;
    border: 1px solid rgb(var(--line) / 0.9);
    background: rgb(var(--glass) / 0.8);
    backdrop-filter: blur(20px) saturate(1.5);
    -webkit-backdrop-filter: blur(20px) saturate(1.5);
    box-shadow: var(--shadow-soft);
  }

  .hx-title {
    min-width: 0;
    flex-shrink: 1;
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
  }

  .hx-search {
    display: flex;
    flex: 1;
    justify-content: flex-end;
  }

  .hx-right {
    display: none;
    align-items: center;
    gap: 0.375rem;
  }

  .hx-app {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 2.75rem;
    padding-inline: 1.125rem 0.875rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 650;
    text-decoration: none;
    color: rgb(var(--accent-fg));
    background: rgb(var(--accent));
    box-shadow: 0 8px 24px -10px rgb(var(--accent) / 0.75);
    transition:
      filter 0.2s ease,
      transform 0.2s ease;
  }

  .hx-app:hover {
    filter: brightness(1.08);
  }

  .hx-app:active {
    transform: scale(0.97);
  }

  @media (min-width: 50rem) {
    .hx {
      max-width: 82rem;
      margin-inline: auto;
      gap: 1.25rem;
      padding-inline-start: 1.125rem;
    }

    .hx-search {
      justify-content: center;
    }

    .hx-search :global(site-search) {
      width: 100%;
      max-width: 26rem;
    }

    .hx-right {
      display: flex;
    }
  }
</style>
