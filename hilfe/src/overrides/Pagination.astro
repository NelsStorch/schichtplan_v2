---
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import ArrowRight from '@lucide/astro/icons/arrow-right';

const { prev, next } = Astro.locals.starlightRoute.pagination;
---

{
  (prev || next) && (
    <nav class="pg print:hidden" aria-label="Weitere Seiten">
      {prev ? (
        <a href={prev.href} rel="prev" class="pg-link">
          <span class="pg-kicker">
            <ArrowLeft size={14} strokeWidth={2.2} aria-hidden="true" /> Zurück
          </span>
          <span class="pg-title">{prev.label}</span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a href={next.href} rel="next" class="pg-link pg-link--next">
          <span class="pg-kicker">
            Weiter <ArrowRight size={14} strokeWidth={2.2} aria-hidden="true" />
          </span>
          <span class="pg-title">{next.label}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .pg {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: 0.75rem;
  }

  .pg-link {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1.125rem 1.25rem;
    border-radius: 1.25rem;
    border: 1px solid rgb(var(--line));
    background: rgb(var(--surface));
    text-decoration: none;
    box-shadow: var(--shadow-soft);
    transition:
      border-color 0.2s ease,
      transform 0.35s var(--ease-out-expo);
  }

  .pg-link:hover {
    border-color: rgb(var(--accent) / 0.45);
    transform: translateY(-2px);
  }

  .pg-link--next {
    text-align: end;
    align-items: flex-end;
    background:
      linear-gradient(135deg, transparent 40%, rgb(var(--accent) / 0.07)),
      rgb(var(--surface));
  }

  .pg-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--__sl-font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(var(--fg-subtle));
  }

  .pg-link--next .pg-kicker {
    color: rgb(var(--accent-ink));
  }

  .pg-title {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 750;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: rgb(var(--fg));
  }
</style>
