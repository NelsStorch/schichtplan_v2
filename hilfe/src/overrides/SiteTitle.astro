---
// Cevi-Logo + Wortmarke «Hilfe» mit kleinem Zusatz, statt nur Text
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="st" aria-label="Cevi Schichtplan Hilfe, Startseite">
  <span class="st-logo" aria-hidden="true">
    <img src="/cevi-logo.svg" alt="" width="30" height="30" />
  </span>
  <span class="st-text" translate="no">
    <span class="st-name">Hilfe</span>
    <span class="st-sub">Cevi Schichtplan</span>
  </span>
</a>

<style>
  .st {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
    text-decoration: none;
    white-space: nowrap;
  }

  .st-logo {
    display: grid;
    place-items: center;
    width: 2.375rem;
    height: 2.375rem;
    flex-shrink: 0;
    border-radius: 0.875rem;
    background: rgb(255 255 255);
    box-shadow:
      inset 0 0 0 1px rgb(var(--line)),
      0 6px 16px -8px rgb(var(--shadow) / 0.5);
    transition: transform 0.3s var(--ease-out-expo);
  }

  .st:hover .st-logo {
    transform: rotate(-6deg) scale(1.05);
  }

  .st-logo img {
    width: 1.625rem;
    height: 1.625rem;
  }

  .st-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.05;
  }

  .st-name {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 800;
    letter-spacing: -0.035em;
    color: rgb(var(--fg));
  }

  .st-sub {
    margin-top: 0.125rem;
    font-family: var(--__sl-font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--fg-subtle));
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
