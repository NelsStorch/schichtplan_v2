---
// Ein Knopf statt Dropdown: wechselt Hell/Dunkel. Ohne Klick folgt die Seite dem System.
// Speicher-Schlüssel wie Starlight (ThemeProvider liest ihn beim Laden, ohne Flackern).
import Moon from '@lucide/astro/icons/moon';
import Sun from '@lucide/astro/icons/sun';
---

<hx-theme-toggle>
  <button type="button" class="tt" aria-label="Hell oder dunkel">
    <span class="tt-icon tt-sun"><Sun size={18} strokeWidth={1.9} aria-hidden="true" /></span>
    <span class="tt-icon tt-moon"><Moon size={18} strokeWidth={1.9} aria-hidden="true" /></span>
  </button>
</hx-theme-toggle>

<script>
  const storageKey = 'starlight-theme';

  const stored = () => {
    try {
      return localStorage.getItem(storageKey);
    } catch {
      return null;
    }
  };

  const apply = (theme: 'light' | 'dark') => {
    document.documentElement.dataset.theme = theme;
  };

  matchMedia('(prefers-color-scheme: light)').addEventListener('change', (e) => {
    if (!stored()) apply(e.matches ? 'light' : 'dark');
  });

  class ThemeToggle extends HTMLElement {
    connectedCallback() {
      this.querySelector('button')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        apply(next);
        try {
          localStorage.setItem(storageKey, next);
        } catch {
          // Speicher gesperrt: gilt nur für diese Seite
        }
      });
    }
  }
  if (!customElements.get('hx-theme-toggle')) customElements.define('hx-theme-toggle', ThemeToggle);
</script>

<style>
  hx-theme-toggle {
    display: inline-flex;
  }

  .tt {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid rgb(var(--line));
    background: rgb(var(--surface-2) / 0.7);
    color: rgb(var(--fg-muted));
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .tt:hover {
    color: rgb(var(--fg));
    background: rgb(var(--surface-2));
  }

  .tt-icon {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    transition:
      transform 0.45s var(--ease-out-expo),
      opacity 0.3s ease;
  }

  :global([data-theme='dark']) .tt-sun,
  :global([data-theme='light']) .tt-moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }
</style>
