---
// Unter jeder Seite: Weiter/Zurück und ein ruhiger Kontakt-Streifen statt «Built with Starlight».
import Pagination from 'virtual:starlight/components/Pagination';
import LifeBuoy from '@lucide/astro/icons/life-buoy';

const isSplash = Astro.locals.starlightRoute.entry.data.template === 'splash';
---

<footer class="ft">
  {!isSplash && <Pagination />}

  <div class="ft-help print:hidden">
    <span class="ft-icon" aria-hidden="true"><LifeBuoy size={20} strokeWidth={1.9} /></span>
    <div class="ft-copy">
      <p class="ft-title">Nicht gefunden, was du suchst?</p>
      <p class="ft-text">
        Frag zuerst das OK deines Anlasses oder deine Abteilungsleitung. Fehler im Schichtplan selbst meldest du
        über <a href="/wissen/kontakt/">Kontakt</a>.
      </p>
    </div>
  </div>

  <div class="ft-bottom">
    <span>© {new Date().getFullYear()} Cevi Schichtplan · ehrenamtlich &amp; Open Source</span>
    <nav aria-label="Weitere Seiten des Schichtplans">
      <a href="https://cevi-schichtplan.ch">cevi-schichtplan.ch</a>
      <a href="https://login.cevi-schichtplan.ch">Login</a>
      <a href="https://github.com/NelsStorch/schichtplan_v2" rel="noopener">GitHub</a>
    </nav>
  </div>
</footer>

<style>
  .ft {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 4rem;
  }

  .ft-help {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem;
    border-radius: 1.25rem;
    border: 1px dashed rgb(var(--line-strong));
  }

  .ft-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.875rem;
    background: rgb(var(--surface-2));
    color: rgb(var(--fg-muted));
  }

  .ft-title {
    font-family: var(--font-display);
    font-weight: 750;
    font-size: 1.0625rem;
    color: rgb(var(--fg));
  }

  .ft-text {
    margin-top: 0.25rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgb(var(--fg-muted));
  }

  .ft-text a {
    color: rgb(var(--accent-ink));
    font-weight: 600;
  }

  .ft-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: 1.5rem 0.5rem;
    border-top: 1px solid rgb(var(--line));
    font-size: 0.8125rem;
    color: rgb(var(--fg-subtle));
  }

  .ft-bottom nav {
    display: flex;
    gap: 1.25rem;
  }

  .ft-bottom a {
    color: inherit;
    text-decoration: none;
  }

  .ft-bottom a:hover {
    color: rgb(var(--fg));
  }
</style>
