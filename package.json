{
  "name": "schichtplan-v2",
  "version": "2.0.0",
  "private": true,
  "description": "Cevi Schichtplan V2 - Multi-Tenant, Multi-Event Shift Management",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:local": "npm run dev --workspaces",
    "dev:docker": "docker compose -f docker-compose.dev.yml up --build",
    "dev:docker:down": "docker compose -f docker-compose.dev.yml down",
    "prod:docker:up": "docker compose up -d --build",
    "prod:docker:down": "docker compose down",
    "prod:docker:logs": "docker compose logs -f",
    "build": "npm run build --workspaces",
    "db:migrate": "npm run db:migrate --workspace=apps/backend",
    "db:seed": "npm run db:seed --workspace=apps/backend",
    "db:studio": "npm run db:studio --workspace=apps/backend",
    "test": "npm run test --workspace=apps/backend && npm run test --workspace=apps/web",
    "typecheck": "tsc --noEmit -p apps/backend && tsc --noEmit -p apps/web && tsc --noEmit -p apps/login && tsc --noEmit -p apps/landing && tsc --noEmit -p apps/admin",
    "hilfe:dev": "npm --prefix hilfe run dev",
    "hilfe:build": "npm --prefix hilfe run build",
    "hilfe:preview": "npm --prefix hilfe run preview",
    "lint": "biome lint .",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@prisma/client": true,
    "prisma": true,
    "@prisma/engines": true,
    "esbuild": true
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "postcss": "^8.5.30",
    "postcss-selector-parser": "^7.1.6"
  }
}
