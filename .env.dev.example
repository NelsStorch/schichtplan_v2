# Lokale Entwicklung
NODE_ENV=development
PORT=4000
DB_USER=cevi_schichtplan
DB_PASSWORD=cevi_schichtplan_dev_pw
DB_NAME=cevi_schichtplan_dev
DATABASE_URL=postgresql://cevi_schichtplan:cevi_schichtplan_dev_pw@localhost:5432/cevi_schichtplan_dev?schema=public
# JWT Secret
JWT_SECRET=super-secret-development-key-min-32-chars

# Cevi.DB OAuth Provider
CEVIDB_BASE_URL=https://db.cevi.ch
CEVIDB_CLIENT_ID=
CEVIDB_CLIENT_SECRET=
CEVIDB_REDIRECT_URI=http://localhost:3002/api/auth/cevidb/callback

# PBS MiData OAuth Provider (Pfadi)
MIDATA_BASE_URL=https://pbs.puzzle.ch
MIDATA_CLIENT_ID=
MIDATA_CLIENT_SECRET=

# Jubla-DB OAuth Provider (Jungwacht Blauring)
JUBLADB_BASE_URL=https://db.jubla.ch
JUBLADB_CLIENT_ID=
JUBLADB_CLIENT_SECRET=

# SMTP E-Mail (Infomaniak)
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=admin@cevi-schichtplan.ch
SMTP_PASSWORD=
SMTP_FROM=Cevi Schichtplan <admin@cevi-schichtplan.ch>

# Server-Fehler-Alarme (z.B. DB-Überlastung oder SMTP-Ausfall per Discord/Slack/HTTP Webhook)
ADMIN_ALERT_WEBHOOK_URL=
ADMIN_ALERT_EMAIL=
