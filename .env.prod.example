NODE_ENV=production
DOMAIN=cevi-schichtplan.ch
DB_USER=cevi_schichtplan
DB_PASSWORD=BITTE_AENDERN_LANGES_SICHERES_PW
DB_NAME=cevi_schichtplan_v2
DATABASE_URL=postgresql://cevi_schichtplan:BITTE_AENDERN_LANGES_SICHERES_PW@db:5432/cevi_schichtplan_v2?schema=public
JWT_SECRET=BITTE_AENDERN_MINDESTENS_32_ZEICHEN_JWT_SECRET

# Cevi.DB OAuth
CEVIDB_BASE_URL=https://db.cevi.ch
CEVIDB_CLIENT_ID=
CEVIDB_CLIENT_SECRET=
CEVIDB_REDIRECT_URI=https://login.cevi-schichtplan.ch/api/auth/cevidb/callback

# Globale Admins (Zugriff auf admin.<domain>): Cevi.DB-Personen-IDs, kommagetrennt.
# Die ID steht in der Cevi.DB-Adresse der Person (.../people/<ID>). Wer sich mit Cevi.DB anmeldet, wird automatisch Admin.
GLOBAL_ADMIN_CEVIDB_IDS=
# Admin-Portal: Anmeldung gilt dort höchstens so viele Stunden (Vorgabe 12), danach neu anmelden.
# ADMIN_SESSION_MAX_HOURS=12
# Admin-Portal nur nach Anmeldung über Cevi.DB (Vorgabe in Produktion: true). Nur abschalten,
# wenn Cevi.DB auf dieser Umgebung nicht geht (z. B. Dev ohne eingetragene Redirect-URI).
# ADMIN_REQUIRE_CEVIDB_LOGIN=true

# Cevi.DB-Rollen und -Felder (alles optional, Vorgaben stehen in apps/backend/src/config/cevidb.ts).
# Listen sind kommagetrennt; leer lassen = Vorgabe. Rollen = `role_class` aus dem Cevi.DB-Profil.
# Rollen, die als Abteilungsleitung gelten (dürfen für ihre Ortsgruppe eine Abteilung/Subdomain anlegen):
# CEVIDB_DEPARTMENT_LEADER_ROLES=Group::Jungschar::Abteilungsleiter
# Profilfeld mit der Ortsgruppen-ID (Zuordnung zur Abteilung beim Login):
# CEVIDB_OAUTH_SCOPES=email name with_roles groups
# CEVIDB_ORTSGRUPPE_FIELD=ortsgruppe_id
# Stufen: Rollen mit diesem Präfix gehören zu einer Stufe; Leitung und Teilnehmer nach Rollenname:
# CEVIDB_STUFE_ROLE_PREFIX=Group::Stufe::
# CEVIDB_STUFE_LEADER_ROLES=Gruppenleiter,Stufenleiter
# CEVIDB_STUFE_PARTICIPANT_ROLES=Teilnehmer

# SMTP E-Mail (Infomaniak)
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=admin@cevi-schichtplan.ch
SMTP_PASSWORD=
SMTP_FROM=Cevi Schichtplan <admin@cevi-schichtplan.ch>

# Erinnerungs-Mail 24 Stunden vor jeder Schicht (an bestätigte E-Mails). Vorgabe: aus
SHIFT_REMINDERS_ENABLED=false

# Datenschutzerklärung: verantwortliche Stelle (nur hier, nie im Repo; erscheint erst auf Klick)
PRIVACY_CONTACT_NAME=
PRIVACY_CONTACT_STREET=
PRIVACY_CONTACT_CITY=
PRIVACY_CONTACT_EMAIL=

# Server-Fehler-Alarme (z.B. DB-Überlastung oder SMTP-Ausfall per Discord/Slack/HTTP Webhook)
ADMIN_ALERT_WEBHOOK_URL=
ADMIN_ALERT_EMAIL=
