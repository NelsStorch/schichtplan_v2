# Einheitliche Zeilenenden und Zeichensatz in allen Editoren (passend zu .gitattributes)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.{ps1,bat,cmd}]
end_of_line = crlf

[*.{png,jpg,jpeg,gif,ico,webp,woff,woff2,ttf,eot,pdf,zip,gz}]
charset = unset
end_of_line = unset
insert_final_newline = unset
