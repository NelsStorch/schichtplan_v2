generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id           String             @id @default(uuid())
  name         String
  slug         String             @unique
  logoUrl      String?
  primaryColor String?            @default("#e11d48")
  contactEmail String?
  // Cevi.DB-Gruppen-ID der Ortsgruppe (Feld `ortsgruppe_id` im Cevi.DB-Profil).
  // Wer sich mit Cevi.DB anmeldet und zu dieser Ortsgruppe gehört, wird automatisch Mitglied.
  ceviDbGroupId Int?              @unique
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  events       Event[]
  members      DepartmentMember[]

  @@map("departments")
}

model User {
  id            String             @id @default(uuid())
  email         String?            @unique
  passwordHash  String?
  ceviDbId      Int?               @unique
  firstName     String
  lastName      String
  ceviName      String?
  phone         String?
  birthDate     DateTime?          // Geburtsdatum für Schicht-Altersrichtlinien (z.B. Bar ab 18)
  isGlobalAdmin Boolean            @default(false)
  ceviDbData    Json?              // Vollständiges Cevi.DB (Hitobito) Profil inkl. Rollen, Gruppen, etc.
  ceviDbSyncedAt DateTime?         // Zeitstempel der letzten Cevi.DB Synchronisation
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  memberships   DepartmentMember[]
  signups       ShiftSignup[]
  organizedEvents EventOrganizer[]

  @@map("users")
}

model DepartmentMember {
  id           String     @id @default(uuid())
  departmentId String
  userId       String
  role         String     @default("HELPER") // ADMIN, PLANNER, HELPER
  createdAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@map("department_members")
}

model Event {
  id                String            @id @default(uuid())
  departmentId      String
  title             String
  slug              String
  description       String?
  logoUrl           String?           // Event-spezifisches Logo
  bannerUrl         String?           // Event-Hintergrundbild / Hero-Banner
  startDate         DateTime
  endDate           DateTime
  isPublished       Boolean           @default(true)
  allowPublicSignup Boolean           @default(true)
  signupMode        String            @default("OPEN") // "NAME_ONLY", "OPEN", "LOGIN_REQUIRED", "CEVIDB_ONLY"
  requireEmailForGuests Boolean       @default(false)
  requirePhoneForGuests Boolean       @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  department        Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  shifts            Shift[]
  organizers        EventOrganizer[]  // Event-spezifisches Organisationskomitee (OK)

  @@unique([departmentId, slug])
  @@map("events")
}

model EventOrganizer {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  role      String   @default("OK_MEMBER") // "OK_LEAD", "OK_MEMBER"
  roleTitle String?  // z.B. "OK-Präsident", "Bau & Logistik", "Kassier", "Grillchef"
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_organizers")
}

model Shift {
  id            String        @id @default(uuid())
  eventId       String
  title         String
  category      String
  description   String?
  startTime     DateTime
  endTime       DateTime
  requiredSlots Int           @default(1)
  minAge        Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  signups       ShiftSignup[]

  @@map("shifts")
}

model ShiftSignup {
  id          String   @id @default(uuid())
  shiftId     String
  userId      String?
  guestName   String?  // Cevi-Name oder Name bei passwortloser Anmeldung
  guestEmail  String?
  guestPhone  String?
  isConfirmed Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  shift       Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("shift_signups")
}

model Upload {
  id        String   @id @default(uuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@map("uploads")
}

