// Prisma 7: Client wird nach src/generated/prisma erzeugt (nicht eingecheckt, `npx prisma generate`).
// ESM mit .js-Endungen, passend zu "module": "NodeNext" im Backend.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// Die Verbindung (DATABASE_URL) steht in prisma.config.ts, die App verbindet über @prisma/adapter-pg.
datasource db {
  provider = "postgresql"
}

enum OrganizationType {
  CEVI
  PFADI
  JUBLA
  OTHER
}

model Department {
  id           String             @id @default(uuid())
  name         String
  slug         String
  organization OrganizationType   @default(CEVI)
  logoUrl      String?
  primaryColor   String?            @default("#e11d48")
  secondaryColor String?            @map("secondary_color")
  qrStyle        String?            @default("CORNERS") @map("qr_style")
  qrCustomColors Boolean            @default(false) @map("qr_custom_colors")
  qrColorPrimary String?            @map("qr_color_primary")
  qrColorSecondary String?          @map("qr_color_secondary")
  // Kontaktperson der Abteilung: Abteilungsleitung oder jemand mit dem Recht «Personen und Rechte verwalten»
  contactUserId String?           @map("contact_user_id")
  contactUser   User?             @relation("DepartmentContactUser", fields: [contactUserId], references: [id], onDelete: SetNull)
  // Hitobito-Gruppe der Abteilung (Cevi.DB, PBS MiData oder Jubla-DB): die Ortsgruppe/Abteilung/Schar oder Jungschar.
  // Wer sich mit Hitobito anmeldet und dort Rollen hat, wird automatisch Mitglied (siehe services/homeDepartment.ts).
  hitobitoGroupId Int?              @map("hitobito_group_id")
  // Startseite (Liste der Anlässe) nur für Mitglieder (Vorgabe: an); öffentliche Anlässe bleiben per Link erreichbar
  membersOnly   Boolean           @default(true) @map("members_only")
  // Passwortlose Anmeldung (Spitzname + Geburtsdatum) für diese Abteilung erlaubt
  allowPasswordless Boolean       @default(true) @map("allow_passwordless")
  // Beitrittsmodus für E-Mail-Konten: OPEN (Verzeichnis), LINK_ONLY (Abteilungs-Link), INVITE_ONLY (nur Einladung)
  joinMode      String            @default("LINK_ONLY") @map("join_mode")
  // Geheimer Einladungs-Token für bestätigten Beitritt (v. a. bei INVITE_ONLY)
  inviteToken   String?           @unique @map("invite_token")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  events       Event[]
  members      DepartmentMember[]
  templates    EventTemplate[]
  taskDefinitions TaskDefinition[]
  stufen       DepartmentStufe[]
  // Personen, die diese Abteilung als Heimabteilung haben (selbst angegeben oder aus Cevi.DB)
  homeUsers    User[]             @relation("UserHomeDepartment")
  // Anlässe anderer Abteilungen, die diese Abteilung freigeschaltet haben (Whitelist)
  allowedInEvents EventAllowedDepartment[]
  auditLogs    DepartmentAuditLog[]

  @@unique([organization, slug])
  @@unique([organization, hitobitoGroupId])
  @@map("departments")
}

// Stufen einer Abteilung (z. B. «Hiskia», «Fröschli»). Gepflegt von der Abteilungsleitung.
model DepartmentStufe {
  id              String              @id @default(uuid())
  departmentId    String              @map("department_id")
  name            String
  // Hitobito-Gruppe der Stufe: Personen mit einer Rolle in dieser Gruppe werden automatisch zugeordnet
  hitobitoGroupId Int?                @map("hitobito_group_id")
  sortOrder       Int                 @default(0) @map("sort_order")
  createdAt       DateTime            @default(now()) @map("created_at")
  department      Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  members         UserStufe[]
  events          EventAllowedStufe[]

  @@unique([departmentId, name])
  @@unique([departmentId, hitobitoGroupId])
  @@map("department_stufen")
}

// Gruppenstruktur aus der Hitobito-Gruppen-API (Scope `groups`), beim Login aufgefrischt. Keine Personendaten.
model HitobitoGroup {
  provider       OrganizationType @default(CEVI)
  id             Int
  name           String
  // Jungschar-Ebene der Gruppe (bei einer Jungschar ihre eigene ID), null ausserhalb einer Jungschar
  jungscharId    Int?     @map("jungschar_id")
  ortsgruppeId   Int?     @map("ortsgruppe_id")
  // Nur bei Ortsgruppen: Anzahl Jungscharen. Mehr als eine heisst: eine Abteilung pro Jungschar
  jungscharCount Int?     @map("jungschar_count")
  // Gruppentyp laut Gruppen-API (übersetzt, z. B. «Abteilung», «Region», «Ortsgruppe»)
  groupType      String?  @map("group_type")
  fetchedAt      DateTime @map("fetched_at")

  @@id([provider, id])
  @@index([provider, ortsgruppeId])
  @@map("hitobito_groups")
}

// Stufen-Rollen einer Person laut Hitobito (Rollen mit Präfix Group::Stufe::), bei jedem Login ersetzt.
// Unabhängig davon, ob eine Abteilung die Stufe schon erfasst hat (Vorschläge, «nur Leitende», Admin-Portal).
model UserHitobitoStufe {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  groupId   Int      @map("group_id")
  groupName String   @map("group_name")
  kind      String   // "LEITUNG", "TEILNEHMER", "ANDERE"
  roleNames String[] @default([]) @map("role_names")
  isPrimary Boolean  @default(false) @map("is_primary")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
  @@map("user_hitobito_stufen")
}

// Alle Rollen einer Person laut Hitobito (Cevi.DB, MiData, Jubla-DB), bei jedem Login ersetzt (keine Historie).
// Nur Rollentyp und Gruppe, kein Rohprofil. Zweck: nachvollziehen, warum jemand ein Recht hat oder nicht.
// Lesen dürfen sie nur globale Admins (Diagnose im Admin-Portal). Wie eine Rolle zählt, wird beim Anzeigen
// mit der aktuellen Konfiguration berechnet und nicht gespeichert.
model UserHitobitoRole {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  roleClass String  @map("role_class")
  roleName  String? @map("role_name")
  groupId   Int?    @map("group_id")
  groupName String? @map("group_name")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_hitobito_roles")
}

// Stufe einer Person mit Rolle. Quelle CEVIDB wird bei jedem Cevi.DB-Login neu abgeglichen.
model UserStufe {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  stufeId   String          @map("stufe_id")
  role      String          @default("TEILNEHMER") // "LEITUNG", "TEILNEHMER"
  source    String          @default("SELF") // "SELF", "CEVIDB"
  createdAt DateTime        @default(now()) @map("created_at")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  stufe     DepartmentStufe @relation(fields: [stufeId], references: [id], onDelete: Cascade)

  @@unique([userId, stufeId])
  @@index([stufeId])
  @@map("user_stufen")
}

model User {
  id               String             @id @default(uuid())
  email            String?            @unique
  passwordHash     String?
  provider         OrganizationType   @default(CEVI) @map("provider")
  providerId       String?            @map("provider_id")
  firstName        String
  lastName         String?
  nickname         String?            @map("nickname")
  phone            String?
  birthDate        DateTime?          // Geburtsdatum für Schicht-Altersrichtlinien (z.B. Bar ab 18)
  isGlobalAdmin    Boolean            @default(false)
  // Aus dem Hitobito-Profil beim Login abgeleitet (siehe services/cevidb.ts)
  ortsgruppeId          Int?     @map("ortsgruppe_id")
  ortsgruppeName        String?  @map("ortsgruppe_name")
  departmentLeader      Boolean  @default(false) @map("department_leader")
  leaderGroupName       String?  @map("leader_group_name")
  // Jungscharen der Rollen laut Hitobito-Gruppenstruktur; leer, solange sie nicht geprüft werden konnten
  jungscharIds          Int[]    @default([]) @map("jungschar_ids")
  // Gruppen der Abteilungsleitungs-Rollen (role.group_id), nicht aus dem selbst änderbaren Feld `ortsgruppe_id`
  leaderGroupIds        Int[]    @default([]) @map("leader_group_ids")
  providerSyncedAt DateTime?     @map("provider_synced_at")
  // Heimabteilung: aus Hitobito (Ortsgruppe) oder beim Login selbst angegeben
  homeDepartmentId     String?     @map("home_department_id")
  homeDepartmentSource String?     @map("home_department_source") // "CEVIDB", "SELF", "CONFIRMED" (selbst gewählt, von der Abteilungsleitung bestätigt)
  // Nur bei "CONFIRMED" gesetzt: Wer hat die Zugehörigkeit wann bestätigt? (Verlauf im Protokoll der Abteilung)
  homeDepartmentConfirmedAt   DateTime? @map("home_department_confirmed_at")
  homeDepartmentConfirmedById String?   @map("home_department_confirmed_by_id")
  homeDepartmentConfirmedBy   User?     @relation("HomeDepartmentConfirmedBy", fields: [homeDepartmentConfirmedById], references: [id], onDelete: SetNull)
  confirmedHomeDepartments    User[]    @relation("HomeDepartmentConfirmedBy")
  // Gesetzt, sobald die Person ihre Abteilung angegeben hat (auch «keine Abteilung»). Null = nachfragen.
  departmentSetupAt    DateTime?   @map("department_setup_at")
  emailVerified       Boolean            @default(false) @map("email_verified")
  emailVerifiedAt     DateTime?          @map("email_verified_at")
  /// Zuletzt gesetztes Passwort: ältere Login-Tokens gelten danach nicht mehr
  passwordChangedAt   DateTime?          @map("password_changed_at")
  /// Erinnerungs-Mail vor eigenen Schichten (im Profil abschaltbar)
  shiftRemindersEnabled Boolean          @default(true) @map("shift_reminders_enabled")
  /// Vorlaufzeiten (in Minuten vor Schichtbeginn) für E-Mail-Erinnerungen
  emailReminderMinutes  Int[]            @default([1440]) @map("email_reminder_minutes")
  /// Browser-Push-Erinnerungen vor eigenen Schichten
  pushRemindersEnabled  Boolean          @default(true) @map("push_reminders_enabled")
  /// Vorlaufzeiten (in Minuten vor Schichtbeginn) für Browser-Push-Erinnerungen
  pushReminderMinutes   Int[]            @default([60, 1440]) @map("push_reminder_minutes")
  /// Browser-Push, wenn jemand eine zur Übernahme angebotene Schicht übernimmt
  pushNotifyReplacement Boolean          @default(true) @map("push_notify_replacement")
  /// Browser-Push bei neuen Nachrichten vom OK
  pushNotifyMessages    Boolean          @default(true) @map("push_notify_messages")
  /// E-Mail-Benachrichtigung bei noch offenen Verpflegungs-Bons
  emailNotifyCateringTokens Boolean       @default(true) @map("email_notify_catering_tokens")
  /// Browser-Push bei noch offenen Verpflegungs-Bons
  pushNotifyCateringTokens  Boolean       @default(true) @map("push_notify_catering_tokens")
  /// E-Mail, wenn jemand eine zur Übernahme angebotene Schicht übernimmt
  emailNotifyReplacement   Boolean        @default(true) @map("email_notify_replacement")
  /// E-Mail bei neuen Mitteilungen vom OK
  emailNotifyMessages      Boolean        @default(true) @map("email_notify_messages")
  /// Geheimer Token für den persönlichen Webcal/iCal-Kalenderfeed
  calendarToken       String?            @unique @map("calendar_token")
  /// Letzter Tag mit Nutzung (nur das Datum, ohne Uhrzeit). Höchstens ein Schreibzugriff pro Person und Tag (plugins/jwt.ts)
  lastSeenOn          DateTime?          @db.Date @map("last_seen_on")
  /// Zwei-Faktor (TOTP, RFC 6238): Secret AES-256-GCM-verschlüsselt (services/twoFactor.ts), nie im Klartext
  totpSecret          String?            @map("totp_secret")
  /// Secret während der Einrichtung, bis der erste Code bestätigt ist
  totpPendingSecret   String?            @map("totp_pending_secret")
  /// Gesetzt = 2FA aktiv. Gilt immer beim Passwort-Login.
  totpEnabledAt       DateTime?          @map("totp_enabled_at")
  /// Zuletzt verwendeter TOTP-Zeitschritt (gegen das erneute Verwenden desselben Codes)
  totpLastStep        Int?               @map("totp_last_step")
  /// 2FA auch beim Login über Cevi.DB/Hitobito verlangen (sonst nur beim Passwort-Login)
  totpOnProviderLogin Boolean            @default(false) @map("totp_on_provider_login")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  homeDepartment Department?       @relation("UserHomeDepartment", fields: [homeDepartmentId], references: [id], onDelete: SetNull)
  memberships   DepartmentMember[]
  stufen        UserStufe[]
  hitobitoStufen UserHitobitoStufe[]
  hitobitoRoles  UserHitobitoRole[]
  signups       ShiftSignup[]
  organizedEvents EventOrganizer[]
  eventAnswers  EventAnswer[]
  eventAccessGrants EventAccessGrant[]
  deregistrations EventDeregistration[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  twoFactorRecoveryCodes  TwoFactorRecoveryCode[]
  contactForEvents        Event[]            @relation("EventContactUser")
  contactForDepartments   Department[]       @relation("DepartmentContactUser")
  shiftResponsibles       ShiftResponsible[]
  eventDayResponsibles    EventDayResponsible[]
  helperSignupLogs        ShiftSignupLog[]   @relation("HelperUser")
  performedSignupLogs     ShiftSignupLog[]   @relation("PerformedByUser")
  pushSubscriptions       PushSubscription[]
  cateringTokens          CateringToken[]

  @@unique([provider, providerId])
  @@index([lastSeenOn])
  @@map("users")
}

// Zugehörigkeit zu einer Abteilung im Schichtplan.
// role: ADMIN = Abteilungsleitung (alle Rechte, nur über Cevi.DB oder das Admin-Portal), HELPER = alle anderen.
// permissions: einzelne Rechte (DEPARTMENT_PERMISSIONS in packages/shared/src/constants.ts), bei ADMIN ohne Bedeutung.
model DepartmentMember {
  id           String     @id @default(uuid())
  departmentId String
  userId       String
  role         String     @default("HELPER")
  permissions  String[]   @default([])
  // Woher die Abteilungsleitung kommt: CEVIDB (Login entzieht sie wieder) oder MANUAL (Admin-Portal)
  leaderSource String?    @map("leader_source")
  createdAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([userId])
  @@map("department_members")
}

model Event {
  id                String            @id @default(uuid())
  departmentId      String
  title             String
  slug              String
  description       String?
  logoUrl           String?           // Event-spezifisches Logo
  bannerUrl         String?           // Event-Hintergrundbild / Hero-Banner
  startDate         DateTime
  endDate           DateTime
  isPublished       Boolean           @default(true)
  allowPublicSignup Boolean           @default(true) // false = Eintragen geschlossen, nur noch das OK teilt ein
  // Wer darf sich eintragen? Schlüssel aus EVENT_ACCESS_TYPES (packages/shared/src/constants.ts)
  accessType        String            @default("PUBLIC") @map("access_type")
  leadersOnly       Boolean           @default(false) @map("leaders_only")
  // Pflichtangaben aus REQUIRED_PROFILE_FIELDS, z. B. ["PHONE", "EMAIL"]
  requiredFields    String[]          @default([]) @map("required_fields")
  minShiftsPerPerson Int?             @map("min_shifts_per_person")
  // Schichtplan-Verantwortliche(r) für Rückfragen bei vollen Schichten
  contactUserId     String?           @map("contact_user_id")
  contactUser       User?             @relation("EventContactUser", fields: [contactUserId], references: [id], onDelete: SetNull)
  // Ab wann zählt ein neuer Tag (z. B. "04:00")
  dayCutoffTime     String            @default("04:00") @map("day_cutoff_time")
  // Verantwortliche pro Schicht oder pro Tag ("BY_SHIFT" oder "BY_DAY")
  responsibleMode   String            @default("BY_SHIFT") @map("responsible_mode")
  // Welche Kontaktdaten der Verantwortlichen sichtbar sind: "BOTH", "PHONE", "EMAIL", "NONE"
  contactVisibility String            @default("BOTH") @map("contact_visibility")
  // Freischaltung zum Eintragen (null = sofort nach Veröffentlichung offen)
  signupOpensAt     DateTime?         @map("signup_opens_at")
  // Austrage-Sperre in Tagen vor Anlassbeginn (null = keine Sperre, 0 = bis Anlassbeginn, z. B. 3 = bis 3 Tage vorher)
  cancelDeadlineDays Int?             @map("cancel_deadline_days")
  // Erlaubte Schicht-Überlappung für Übergaben in Minuten (Standard: 15)
  overlapToleranceMinutes Int         @default(15) @map("overlap_tolerance_minutes")
  // Anwesenheit: "OFF", "OK_ONLY" (nur das OK hakt ab) oder "OK_AND_QR" (zusätzlich Selbst-Check-in per QR-Code)
  attendanceMode    String            @default("OFF") @map("attendance_mode")
  // Check-in Zeitfenster: wie viele Minuten vor Schichtbeginn und nach Schichtende man sich per QR eintragen kann (Standard je 30)
  checkinEarlyMinutes Int             @default(30) @map("checkin_early_minutes")
  checkinLateMinutes  Int             @default(30) @map("checkin_late_minutes")
  // Geheimer Code im QR-Link für den Selbst-Check-in (erneuerbar, alte Plakate werden damit ungültig)
  checkinToken      String?           @unique @map("checkin_token")
  // Verpflegungs- & Getränke-Tokens für Helfende
  cateringTokensEnabled Boolean       @default(false) @map("catering_tokens_enabled")
  cateringTokenItems    String[]      @default(["1x Helfermenü", "1x Getränk"]) @map("catering_token_items")
  cateringEarlyHours    Int           @default(2) @map("catering_early_hours")
  // Stand-PIN für Bar & Verpflegung (z. B. 4 Ziffern)
  cateringStaffPin        String?           @map("catering_staff_pin")
  // Bon-Erinnerung vor Schicht-/Festende aktivieren
  cateringRemindersEnabled Boolean          @default(true) @map("catering_reminders_enabled")
  cateringBatches         CateringBatch[]
  cateringTokens          CateringToken[]
  // «Ersatz gesucht»: Eingetragene dürfen ihre Schicht zur Übernahme anbieten
  allowReplacement  Boolean           @default(true) @map("allow_replacement")
  // Bis wie viele Stunden vor Schichtbeginn (0 = bis Schichtbeginn)
  replacementCutoffHours Int          @default(0) @map("replacement_cutoff_hours")
  // Optionaler Zusatztext des OK für die automatische Schicht-Erinnerung (z. B. Treffpunkt, Kleidung)
  reminderNote      String?           @map("reminder_note")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  department        Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  shifts            Shift[]
  organizers        EventOrganizer[]  // Event-spezifisches Organisationskomitee (OK)
  allowedDepartments EventAllowedDepartment[] // Whitelist: zusätzliche Abteilungen
  allowedStufen     EventAllowedStufe[] // Stufen-Filter (leer = alle Stufen)
  questions         EventQuestion[]
  answers           EventAnswer[]
  accessLinks       EventAccessLink[]
  accessGrants      EventAccessGrant[]
  deregistrations   EventDeregistration[]
  dayResponsibles   EventDayResponsible[]
  signupLogs        ShiftSignupLog[]
  messages          EventMessage[]

  @@unique([departmentId, slug])
  @@map("events")
}

model EventAllowedDepartment {
  eventId      String     @map("event_id")
  departmentId String     @map("department_id")
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([eventId, departmentId])
  @@index([departmentId])
  @@map("event_allowed_departments")
}

model EventAllowedStufe {
  eventId String          @map("event_id")
  stufeId String          @map("stufe_id")
  event   Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stufe   DepartmentStufe @relation(fields: [stufeId], references: [id], onDelete: Cascade)

  @@id([eventId, stufeId])
  @@index([stufeId])
  @@map("event_allowed_stufen")
}

// Eigene Frage eines Anlasses, z. B. «Allergien» oder «T-Shirt-Grösse»
model EventQuestion {
  id        String        @id @default(uuid())
  eventId   String        @map("event_id")
  label     String
  type      String        @default("TEXT") // "TEXT", "YES_NO", "CHOICE"
  options   String[]      @default([])
  required  Boolean       @default(false)
  // ONCE = einmal pro Anlass, PER_SIGNUP = bei jeder Eintragung neu (Antwort pro Schicht)
  scope     String        @default("ONCE")
  sortOrder Int           @default(0) @map("sort_order")
  // Antworten werden so viele Tage nach dem Anlass-Ende gelöscht (null = nie), siehe services/answerRetention.ts
  retentionDays Int?      @map("retention_days")
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers   EventAnswer[]
  signupAnswers ShiftSignupAnswer[]

  @@index([eventId])
  @@map("event_questions")
}

model EventAnswer {
  id         String        @id @default(uuid())
  eventId    String        @map("event_id")
  questionId String        @map("question_id")
  userId     String        @map("user_id")
  value      String
  updatedAt  DateTime      @updatedAt @map("updated_at")
  event      Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  question   EventQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("event_answers")
}

// Antwort auf eine Frage mit scope PER_SIGNUP, gehört zu einer Eintragung
model ShiftSignupAnswer {
  id         String        @id @default(uuid())
  signupId   String        @map("signup_id")
  questionId String        @map("question_id")
  value      String
  signup     ShiftSignup   @relation(fields: [signupId], references: [id], onDelete: Cascade)
  question   EventQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([signupId, questionId])
  @@index([questionId])
  @@map("shift_signup_answers")
}

// Zugangs-Link: gibt Zugang zum Anlass, auch wenn die Person die Regeln nicht erfüllt (Login bleibt nötig)
model EventAccessLink {
  id          String             @id @default(uuid())
  eventId     String             @map("event_id")
  token       String             @unique
  label       String             // z. B. «Mami von Falk» oder «Elternchat Hiskia»
  kind        String             @default("PERSONAL") // "PERSONAL" (erstes Konto) oder "GROUP" (alle mit dem Link)
  boundUserId String?            @map("bound_user_id") // PERSONAL: Konto, das den Link eingelöst hat
  expiresAt   DateTime?          @map("expires_at")
  createdById String?            @map("created_by_id")
  createdAt   DateTime           @default(now()) @map("created_at")
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  grants      EventAccessGrant[]

  @@index([eventId])
  @@map("event_access_links")
}

model EventAccessGrant {
  id        String          @id @default(uuid())
  eventId   String          @map("event_id")
  userId    String          @map("user_id")
  linkId    String          @map("link_id")
  createdAt DateTime        @default(now()) @map("created_at")
  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  link      EventAccessLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@index([linkId])
  @@map("event_access_grants")
}

model EventOrganizer {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  role      String   @default("OK_MEMBER") // "OK_LEAD", "OK_MEMBER"
  roleTitle String?  // z.B. "OK-Präsident", "Bau & Logistik", "Kassier", "Grillchef"
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_organizers")
}

model Shift {
  id              String        @id @default(uuid())
  eventId         String
  title           String?
  category        String?
  isSetupTeardown Boolean       @default(false) @map("is_setup_teardown")
  description     String?
  startTime       DateTime
  endTime         DateTime
  requiredSlots   Int           @default(1)
  minAge          Int?          // Mindestalter für die gesamte Schicht
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tasks           ShiftTask[]
  signups         ShiftSignup[]
  responsibles    ShiftResponsible[]
  signupLogs      ShiftSignupLog[]
  cateringTokens  CateringToken[]

  @@index([eventId, startTime])
  @@index([startTime])
  @@map("shifts")
}

model TaskDefinition {
  id                 String      @id @default(uuid())
  departmentId       String      @map("department_id")
  title              String      // z.B. "Grill", "Kasse", "Bar", "Aufbau"
  description        String?
  minAge             Int?        @map("min_age")
  ageRequirementType String      @default("ALL") @map("age_requirement_type") // "ALL" oder "AT_LEAST_ONE"
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  department         Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  shiftTasks         ShiftTask[]

  @@index([departmentId])
  @@map("task_definitions")
}

model ShiftTask {
  id                 String          @id @default(uuid())
  shiftId            String
  taskDefinitionId   String?         @map("task_definition_id")
  title              String          // z.B. "Grill", "Kasse", "Ausschank / Bar"
  description        String?
  requiredSlots      Int             @default(1)
  minAge             Int?            // Mindestalter für diese Arbeit
  ageRequirementType String          @default("ALL") // "ALL" oder "AT_LEAST_ONE"
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  shift              Shift           @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  taskDefinition     TaskDefinition? @relation(fields: [taskDefinitionId], references: [id], onDelete: SetNull)
  signups            ShiftSignup[]

  @@index([shiftId])
  @@index([taskDefinitionId])
  @@map("shift_tasks")
}

model ShiftSignup {
  id          String     @id @default(uuid())
  shiftId     String
  taskId      String?
  userId      String?
  guestName   String?    // Cevi-Name oder Name bei passwortloser Anmeldung
  guestEmail  String?
  guestPhone  String?
  isConfirmed Boolean    @default(true)
  notes       String?


  /// Bereits verschickte E-Mail-Erinnerungs-Stufen (Minuten vor Schichtbeginn, z. B. [1440, 120])
  sentEmailReminders Int[] @default([]) @map("sent_email_reminders")
  /// Bereits verschickte Browser-Push-Erinnerungs-Stufen (Minuten vor Schichtbeginn, z. B. [60])
  sentPushReminders  Int[] @default([]) @map("sent_push_reminders")
  /// Anwesenheit: null = offen, "PRESENT", "EXCUSED", "NO_SHOW"
  attendance       String?   @map("attendance")
  attendanceAt     DateTime? @map("attendance_at")
  /// "OK" (abgehakt) oder "QR" (Selbst-Check-in)
  attendanceSource String?   @map("attendance_source")
  attendanceByName String?   @map("attendance_by_name")
  /// «Ersatz gesucht» seit (null = nicht angeboten). Die Person bleibt eingetragen, bis jemand übernimmt.
  replacementWantedAt DateTime? @map("replacement_wanted_at")
  /// Freiwilliger Grund, sichtbar für alle, die Namen sehen
  replacementNote     String?   @map("replacement_note")
  /// Wer es für die Person gesetzt hat (OK), null = selbst
  replacementByName   String?   @map("replacement_by_name")
  createdAt   DateTime   @default(now())
  shift       Shift      @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  task        ShiftTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers     ShiftSignupAnswer[]
  cateringTokens   CateringToken[]

  @@index([shiftId])
  @@index([userId])
  @@index([taskId])
  @@map("shift_signups")
}

model EventTemplate {
  id                    String     @id @default(uuid())
  departmentId          String
  title                 String     // Name der Vorlage, z.B. "Chilbi Festzelt (3 Tage)"
  description           String?
  accessType            String     @default("PUBLIC") @map("access_type")
  leadersOnly           Boolean    @default(false) @map("leaders_only")
  requiredFields        String[]   @default([]) @map("required_fields")
  minShiftsPerPerson    Int?       @map("min_shifts_per_person")
  cancelDeadlineDays    Int?       @map("cancel_deadline_days")
  overlapToleranceMinutes Int      @default(15) @map("overlap_tolerance_minutes")
  data                  Json       // Relative Struktur für Schichten und Arbeiten, dazu eigene Fragen und Zugangslisten
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  department            Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId])
  @@map("event_templates")
}

// Abmeldung einer Person von einem Anlass: Person muss keine Schichten übernehmen (Soll entfällt)
model EventDeregistration {
  id          String   @id @default(uuid())
  eventId     String   @map("event_id")
  userId      String   @map("user_id")
  reason      String?  // Optional: z. B. «Im Militär», «Verletzt», «Ferien»
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by_id")
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_deregistrations")
}

model Upload {
  id        String   @id @default(uuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@map("uploads")
}

// Token zur Bestätigung der E-Mail-Adresse (z. B. nach Registrierung oder E-Mail-Änderung)
model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  email     String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Link «Passwort vergessen»: gespeichert wird nur der SHA-256-Hash des Tokens
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model ShiftResponsible {
  id                 String   @id @default(uuid())
  shiftId            String   @map("shift_id")
  userId             String   @map("user_id")
  sentEmailReminders Int[]    @default([]) @map("sent_email_reminders")
  sentPushReminders  Int[]    @default([]) @map("sent_push_reminders")
  createdAt          DateTime @default(now()) @map("created_at")
  shift              Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shiftId, userId])
  @@index([userId])
  @@map("shift_responsibles")
}

/// Web-Push-Subscription eines Geräts (Service Worker PushManager)
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model EventDayResponsible {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  dayDate   String   @map("day_date") // YYYY-MM-DD
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, dayDate, userId])
  @@index([userId])
  @@map("event_day_responsibles")
}

// Protokoll aller Schicht-Eintragungen und -Austragungen
model ShiftSignupLog {
  id                String    @id @default(uuid())
  eventId           String    @map("event_id")
  shiftId           String?   @map("shift_id")
  action            String    // "SIGNUP", "SIGNOFF", "REPLACE" (übernommen, performedByName = wer abgegeben hat) oder "ATTENDANCE"
  helperUserId      String?   @map("helper_user_id")
  helperName        String    @map("helper_name")
  performedByUserId String?   @map("performed_by_user_id")
  performedByName   String?   @map("performed_by_name")
  shiftTitle        String    @map("shift_title")
  shiftStartTime    DateTime? @map("shift_start_time")
  shiftEndTime      DateTime? @map("shift_end_time")
  taskTitle         String?   @map("task_title")
  // Bei ATTENDANCE: neuer Status ("PRESENT", "EXCUSED", "NO_SHOW"), null = zurück auf offen
  attendance        String?   @map("attendance")
  createdAt         DateTime  @default(now()) @map("created_at")

  event             Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  shift             Shift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  helperUser        User?     @relation("HelperUser", fields: [helperUserId], references: [id], onDelete: SetNull)
  performedByUser   User?     @relation("PerformedByUser", fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([shiftId])
  @@map("shift_signup_logs")
}

// Vom OK verschickte Nachrichten an Helfende (nur Verlauf, die Mails gehen einzeln raus)
model EventMessage {
  id             String   @id @default(uuid())
  eventId        String   @map("event_id")
  sentByUserId   String?  @map("sent_by_user_id")
  sentByName     String   @map("sent_by_name")
  subject        String
  body           String
  // "ALL", "SHIFTS", "PEOPLE" oder "OK"
  target         String
  targetLabel    String   @map("target_label")
  recipientCount Int      @map("recipient_count")
  failedCount    Int      @default(0) @map("failed_count")
  createdAt      DateTime @default(now()) @map("created_at")

  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@map("event_messages")
}

/// Protokoll aller Änderungen im Admin-Portal. Ohne Fremdschlüssel: Einträge bleiben, auch wenn
/// Admin, Person, Abteilung oder Anlass später gelöscht werden (Namen werden mitgespeichert).
model AdminAuditLog {
  id          String   @id @default(uuid())
  adminId     String?  @map("admin_id")
  adminName   String   @map("admin_name")
  // z. B. DEPARTMENT_DELETE, USER_ADMIN_GRANT, MEMBER_ROLE_SET
  action      String
  // USER, DEPARTMENT, EVENT
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  targetLabel String   @map("target_label")
  details     Json?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

/// Protokoll der Abteilung: Rechte, Abteilungsleitung, Stufen und Zugehörigkeit von Personen.
/// Ohne Fremdschlüssel auf Personen (Namen werden mitgespeichert), damit Einträge Löschungen überleben.
model DepartmentAuditLog {
  id           String     @id @default(uuid())
  departmentId String     @map("department_id")
  // null = automatisch (Cevi.DB-Login)
  actorId      String?    @map("actor_id")
  actorName    String     @map("actor_name")
  // PERMISSIONS_SET, LEADER_GRANT, LEADER_REVOKE, STUFEN_SET, MEMBER_REMOVE
  action       String
  targetUserId String?    @map("target_user_id")
  targetLabel  String     @map("target_label")
  details      Json?
  createdAt    DateTime   @default(now()) @map("created_at")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId, createdAt])
  @@map("department_audit_logs")
}

/// Abgemeldete Login-Tokens (jti): gelten bis zu ihrem Ablauf nicht mehr. Abgelaufene werden beim Abmelden gelöscht.
/// Wiederherstellungscodes für 2FA (je einmal verwendbar). In der DB nur der SHA-256-Hash.
model TwoFactorRecoveryCode {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_recovery_codes")
}

model RevokedToken {
  jti       String   @id
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("revoked_tokens")
}

/// Nutzungsstatistik ohne Personenbezug: Zähler pro Schweizer Kalendertag (services/usageStats.ts).
/// dim = Unterteilung aus einer festen Liste (z. B. Anmeldeart), department_id = '' für «ohne Abteilung».
model UsageCounter {
  day          DateTime @db.Date
  metric       String
  dim          String   @default("")
  departmentId String   @default("") @map("department_id")
  count        Int      @default(0)

  @@id([day, metric, dim, departmentId])
  @@index([metric, day])
  @@map("usage_counters")
}

/// Anfragen pro Route-Muster (nie die echte URL), Stunde und Statusklasse. Nach 90 Tagen zu Tageswerten zusammengefasst.
model RequestStat {
  // "HOUR" oder "DAY"
  granularity String
  // Beginn der Stunde bzw. des Tages (UTC)
  period      DateTime
  route       String
  method      String
  // "2xx", "3xx", "4xx", "5xx"
  statusClass String   @map("status_class")
  count       Int
  totalMs     Float    @map("total_ms")
  maxMs       Float    @map("max_ms")
  // Anzahl pro Laufzeit-Stufe (Grenzen in REQUEST_DURATION_BUCKETS_MS, letzte Stufe = darüber)
  buckets     Int[]

  @@id([granularity, period, route, method, statusClass])
  @@index([period])
  @@map("request_stats")
}

/// Tägliche Momentaufnahme von Bestandszahlen aus der DB (z. B. Anzahl Konten), damit Verläufe sichtbar sind
model StatsSnapshot {
  day   DateTime @db.Date
  key   String
  value Float

  @@id([day, key])
  @@map("stats_snapshots")
}

// Druck-Tranche für physische Papier-Bons eines Anlasses
model CateringBatch {
  id          String   @id @default(uuid())
  eventId     String   @map("event_id")
  batchNumber Int      @map("batch_number")
  title       String
  mode        String   @default("COMBI") // "COMBI" (1 QR-Code für alle Artikel) oder "SINGLE" (1 QR-Code pro Artikel)
  cardCount   Int      @map("card_count")
  tokenCount  Int      @map("token_count")
  isBlocked   Boolean  @default(false) @map("is_blocked")
  createdAt   DateTime @default(now()) @map("created_at")
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tokens      CateringToken[]

  @@unique([eventId, batchNumber])
  @@index([eventId])
  @@map("catering_batches")
}

// Digitaler oder physischer Verpflegungs- oder Getränkegutschein
model CateringToken {
  id             String         @id @default(uuid())
  shiftSignupId  String?        @map("shift_signup_id")
  shiftId        String?        @map("shift_id")
  userId         String?        @map("user_id")
  eventId        String?        @map("event_id")
  batchId        String?        @map("batch_id")
  qrCode         String?        @map("qr_code")
  cardNumber     Int?           @map("card_number")
  isPhysical     Boolean        @default(false) @map("is_physical")
  title          String
  status         String         @default("AVAILABLE") // "AVAILABLE", "REDEEMED", "BLOCKED"
  redeemedAt     DateTime?      @map("redeemed_at")
  redeemedByName String?        @map("redeemed_by_name")
  reminderSentAt DateTime?      @map("reminder_sent_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  signup         ShiftSignup?   @relation(fields: [shiftSignupId], references: [id], onDelete: Cascade)
  shift          Shift?         @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  event          Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  batch          CateringBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([shiftSignupId])
  @@index([shiftId])
  @@index([userId])
  @@index([eventId])
  @@index([batchId])
  @@index([qrCode])
  @@map("catering_tokens")
}
