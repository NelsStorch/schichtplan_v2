// Prisma 7: Client wird nach src/generated/prisma erzeugt (nicht eingecheckt, `npx prisma generate`).
// ESM mit .js-Endungen, passend zu "module": "NodeNext" im Backend.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

// Die Verbindung (DATABASE_URL) steht in prisma.config.ts, die App verbindet über @prisma/adapter-pg.
datasource db {
  provider = "postgresql"
}

model Department {
  id           String             @id @default(uuid())
  name         String
  slug         String             @unique
  logoUrl      String?
  primaryColor String?            @default("#e11d48")
  contactEmail String?
  // Cevi.DB-Gruppen-ID der Ortsgruppe (Feld `ortsgruppe_id` im Cevi.DB-Profil).
  // Wer sich mit Cevi.DB anmeldet und zu dieser Ortsgruppe gehört, wird automatisch Mitglied.
  ceviDbGroupId Int?              @unique
  // Startseite (Liste der Anlässe) nur für Mitglieder (Vorgabe: an); öffentliche Anlässe bleiben per Link erreichbar
  membersOnly   Boolean           @default(true) @map("members_only")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  events       Event[]
  members      DepartmentMember[]
  templates    EventTemplate[]
  taskDefinitions TaskDefinition[]
  stufen       DepartmentStufe[]
  // Personen, die diese Abteilung als Heimabteilung haben (selbst angegeben oder aus Cevi.DB)
  homeUsers    User[]             @relation("UserHomeDepartment")
  // Anlässe anderer Abteilungen, die diese Abteilung freigeschaltet haben (Whitelist)
  allowedInEvents EventAllowedDepartment[]

  @@map("departments")
}

// Stufen einer Abteilung (z. B. «Hiskia», «Fröschli»). Gepflegt von der Abteilungsleitung.
model DepartmentStufe {
  id            String              @id @default(uuid())
  departmentId  String              @map("department_id")
  name          String
  // Cevi.DB-Gruppe der Stufe: Cevi.DB-Personen mit einer Rolle in dieser Gruppe werden automatisch zugeordnet
  ceviDbGroupId Int?                @map("cevidb_group_id")
  sortOrder     Int                 @default(0) @map("sort_order")
  createdAt     DateTime            @default(now()) @map("created_at")
  department    Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  members       UserStufe[]
  events        EventAllowedStufe[]

  @@unique([departmentId, name])
  @@unique([departmentId, ceviDbGroupId])
  @@map("department_stufen")
}

// Stufen-Rollen einer Person laut Cevi.DB (Rollen mit Präfix Group::Stufe::), bei jedem Cevi.DB-Login ersetzt.
// Unabhängig davon, ob eine Abteilung die Stufe schon erfasst hat (Vorschläge, «nur Leitende», Admin-Portal).
model UserCeviDbStufe {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  groupId   Int      @map("group_id")
  groupName String   @map("group_name")
  kind      String   // "LEITUNG", "TEILNEHMER", "ANDERE"
  roleNames String[] @default([]) @map("role_names")
  isPrimary Boolean  @default(false) @map("is_primary")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
  @@map("user_cevidb_stufen")
}

// Stufe einer Person mit Rolle. Quelle CEVIDB wird bei jedem Cevi.DB-Login neu abgeglichen.
model UserStufe {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  stufeId   String          @map("stufe_id")
  role      String          @default("TEILNEHMER") // "LEITUNG", "TEILNEHMER"
  source    String          @default("SELF") // "SELF", "CEVIDB"
  createdAt DateTime        @default(now()) @map("created_at")
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  stufe     DepartmentStufe @relation(fields: [stufeId], references: [id], onDelete: Cascade)

  @@unique([userId, stufeId])
  @@map("user_stufen")
}

model User {
  id            String             @id @default(uuid())
  email         String?            @unique
  passwordHash  String?
  ceviDbId      Int?               @unique
  firstName     String
  lastName      String
  ceviName      String?
  phone         String?
  address       String?            // Eine Zeile, z. B. "Dorfstrasse 1, 8307 Effretikon"
  birthDate     DateTime?          // Geburtsdatum für Schicht-Altersrichtlinien (z.B. Bar ab 18)
  isGlobalAdmin Boolean            @default(false)
  // Rohes Cevi.DB-Profil: nur zum Entwickeln (Debug-Seite), wird später entfernt. Code liest NIE daraus.
  ceviDbData    Json?
  // Aus dem Cevi.DB-Profil beim Login abgeleitet (siehe services/cevidb.ts)
  ceviDbOrtsgruppeId      Int?     @map("cevidb_ortsgruppe_id")
  ceviDbOrtsgruppeName    String?  @map("cevidb_ortsgruppe_name")
  ceviDbDepartmentLeader  Boolean  @default(false) @map("cevidb_department_leader")
  ceviDbLeaderGroupName   String?  @map("cevidb_leader_group_name")
  ceviDbSyncedAt DateTime?         // Zeitstempel der letzten Cevi.DB Synchronisation
  // Heimabteilung: aus Cevi.DB (Ortsgruppe) oder beim Login selbst angegeben
  homeDepartmentId     String?     @map("home_department_id")
  homeDepartmentSource String?     @map("home_department_source") // "CEVIDB", "SELF"
  // Gesetzt, sobald die Person ihre Abteilung angegeben hat (auch «keine Abteilung»). Null = nachfragen.
  departmentSetupAt    DateTime?   @map("department_setup_at")
  emailVerified       Boolean            @default(false) @map("email_verified")
  emailVerifiedAt     DateTime?          @map("email_verified_at")
  /// Zuletzt gesetztes Passwort: ältere Login-Tokens gelten danach nicht mehr
  passwordChangedAt   DateTime?          @map("password_changed_at")
  /// Erinnerungs-Mail vor eigenen Schichten (im Profil abschaltbar)
  shiftRemindersEnabled Boolean          @default(true) @map("shift_reminders_enabled")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  homeDepartment Department?       @relation("UserHomeDepartment", fields: [homeDepartmentId], references: [id], onDelete: SetNull)
  memberships   DepartmentMember[]
  stufen        UserStufe[]
  ceviDbStufen  UserCeviDbStufe[]
  signups       ShiftSignup[]
  organizedEvents EventOrganizer[]
  eventAnswers  EventAnswer[]
  eventAccessGrants EventAccessGrant[]
  deregistrations EventDeregistration[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  contactForEvents        Event[]            @relation("EventContactUser")
  shiftResponsibles       ShiftResponsible[]
  eventDayResponsibles    EventDayResponsible[]
  helperSignupLogs        ShiftSignupLog[]   @relation("HelperUser")
  performedSignupLogs     ShiftSignupLog[]   @relation("PerformedByUser")

  @@map("users")
}

model DepartmentMember {
  id           String     @id @default(uuid())
  departmentId String
  userId       String
  role         String     @default("HELPER") // ADMIN, PLANNER, HELPER
  createdAt    DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@map("department_members")
}

model Event {
  id                String            @id @default(uuid())
  departmentId      String
  title             String
  slug              String
  description       String?
  logoUrl           String?           // Event-spezifisches Logo
  bannerUrl         String?           // Event-Hintergrundbild / Hero-Banner
  startDate         DateTime
  endDate           DateTime
  isPublished       Boolean           @default(true)
  allowPublicSignup Boolean           @default(true) // false = Eintragen geschlossen, nur noch das OK teilt ein
  // Wer darf sich eintragen? Schlüssel aus EVENT_ACCESS_TYPES (packages/shared/src/constants.ts)
  accessType        String            @default("PUBLIC") @map("access_type")
  leadersOnly       Boolean           @default(false) @map("leaders_only")
  // Pflichtangaben aus REQUIRED_PROFILE_FIELDS, z. B. ["PHONE", "EMAIL"]
  requiredFields    String[]          @default([]) @map("required_fields")
  minShiftsPerPerson Int?             @map("min_shifts_per_person")
  // Schichtplan-Verantwortliche(r) für Rückfragen bei vollen Schichten
  contactUserId     String?           @map("contact_user_id")
  contactUser       User?             @relation("EventContactUser", fields: [contactUserId], references: [id], onDelete: SetNull)
  // Ab wann zählt ein neuer Tag (z. B. "04:00")
  dayCutoffTime     String            @default("04:00") @map("day_cutoff_time")
  // Verantwortliche pro Schicht oder pro Tag ("BY_SHIFT" oder "BY_DAY")
  responsibleMode   String            @default("BY_SHIFT") @map("responsible_mode")
  // Welche Kontaktdaten der Verantwortlichen sichtbar sind: "BOTH", "PHONE", "EMAIL", "NONE"
  contactVisibility String            @default("BOTH") @map("contact_visibility")
  // Freischaltung zum Eintragen (null = sofort nach Veröffentlichung offen)
  signupOpensAt     DateTime?         @map("signup_opens_at")
  // Austrage-Sperre in Tagen vor Anlassbeginn (null = keine Sperre, 0 = bis Anlassbeginn, z. B. 3 = bis 3 Tage vorher)
  cancelDeadlineDays Int?             @map("cancel_deadline_days")
  // Anwesenheit: "OFF", "OK_ONLY" (nur das OK hakt ab) oder "OK_AND_QR" (zusätzlich Selbst-Check-in per QR-Code)
  attendanceMode    String            @default("OFF") @map("attendance_mode")
  // Geheimer Code im QR-Link für den Selbst-Check-in (erneuerbar, alte Plakate werden damit ungültig)
  checkinToken      String?           @unique @map("checkin_token")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  department        Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  shifts            Shift[]
  organizers        EventOrganizer[]  // Event-spezifisches Organisationskomitee (OK)
  allowedDepartments EventAllowedDepartment[] // Whitelist: zusätzliche Abteilungen
  allowedStufen     EventAllowedStufe[] // Stufen-Filter (leer = alle Stufen)
  questions         EventQuestion[]
  answers           EventAnswer[]
  accessLinks       EventAccessLink[]
  accessGrants      EventAccessGrant[]
  deregistrations   EventDeregistration[]
  dayResponsibles   EventDayResponsible[]
  signupLogs        ShiftSignupLog[]
  messages          EventMessage[]

  @@unique([departmentId, slug])
  @@map("events")
}

model EventAllowedDepartment {
  eventId      String     @map("event_id")
  departmentId String     @map("department_id")
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([eventId, departmentId])
  @@map("event_allowed_departments")
}

model EventAllowedStufe {
  eventId String          @map("event_id")
  stufeId String          @map("stufe_id")
  event   Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stufe   DepartmentStufe @relation(fields: [stufeId], references: [id], onDelete: Cascade)

  @@id([eventId, stufeId])
  @@map("event_allowed_stufen")
}

// Eigene Frage eines Anlasses, z. B. «Allergien» oder «T-Shirt-Grösse»
model EventQuestion {
  id        String        @id @default(uuid())
  eventId   String        @map("event_id")
  label     String
  type      String        @default("TEXT") // "TEXT", "YES_NO", "CHOICE"
  options   String[]      @default([])
  required  Boolean       @default(false)
  // ONCE = einmal pro Anlass, PER_SIGNUP = bei jeder Eintragung neu (Antwort pro Schicht)
  scope     String        @default("ONCE")
  sortOrder Int           @default(0) @map("sort_order")
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers   EventAnswer[]
  signupAnswers ShiftSignupAnswer[]

  @@map("event_questions")
}

model EventAnswer {
  id         String        @id @default(uuid())
  eventId    String        @map("event_id")
  questionId String        @map("question_id")
  userId     String        @map("user_id")
  value      String
  updatedAt  DateTime      @updatedAt @map("updated_at")
  event      Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  question   EventQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
  @@map("event_answers")
}

// Antwort auf eine Frage mit scope PER_SIGNUP, gehört zu einer Eintragung
model ShiftSignupAnswer {
  id         String        @id @default(uuid())
  signupId   String        @map("signup_id")
  questionId String        @map("question_id")
  value      String
  signup     ShiftSignup   @relation(fields: [signupId], references: [id], onDelete: Cascade)
  question   EventQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([signupId, questionId])
  @@map("shift_signup_answers")
}

// Zugangs-Link: gibt Zugang zum Anlass, auch wenn die Person die Regeln nicht erfüllt (Login bleibt nötig)
model EventAccessLink {
  id          String             @id @default(uuid())
  eventId     String             @map("event_id")
  token       String             @unique
  label       String             // z. B. «Mami von Falk» oder «Elternchat Hiskia»
  kind        String             @default("PERSONAL") // "PERSONAL" (erstes Konto) oder "GROUP" (alle mit dem Link)
  boundUserId String?            @map("bound_user_id") // PERSONAL: Konto, das den Link eingelöst hat
  expiresAt   DateTime?          @map("expires_at")
  createdById String?            @map("created_by_id")
  createdAt   DateTime           @default(now()) @map("created_at")
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  grants      EventAccessGrant[]

  @@map("event_access_links")
}

model EventAccessGrant {
  id        String          @id @default(uuid())
  eventId   String          @map("event_id")
  userId    String          @map("user_id")
  linkId    String          @map("link_id")
  createdAt DateTime        @default(now()) @map("created_at")
  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  link      EventAccessLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_access_grants")
}

model EventOrganizer {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  role      String   @default("OK_MEMBER") // "OK_LEAD", "OK_MEMBER"
  roleTitle String?  // z.B. "OK-Präsident", "Bau & Logistik", "Kassier", "Grillchef"
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_organizers")
}

model Shift {
  id              String        @id @default(uuid())
  eventId         String
  title           String
  category        String?
  isSetupTeardown Boolean       @default(false) @map("is_setup_teardown")
  description     String?
  startTime       DateTime
  endTime         DateTime
  requiredSlots   Int           @default(1)
  minAge          Int?          // Mindestalter für die gesamte Schicht
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tasks           ShiftTask[]
  signups         ShiftSignup[]
  responsibles    ShiftResponsible[]
  signupLogs      ShiftSignupLog[]

  @@map("shifts")
}

model TaskDefinition {
  id                 String      @id @default(uuid())
  departmentId       String      @map("department_id")
  title              String      // z.B. "Grill", "Kasse", "Bar", "Aufbau"
  description        String?
  minAge             Int?        @map("min_age")
  ageRequirementType String      @default("ALL") @map("age_requirement_type") // "ALL" oder "AT_LEAST_ONE"
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  department         Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  shiftTasks         ShiftTask[]

  @@map("task_definitions")
}

model ShiftTask {
  id                 String          @id @default(uuid())
  shiftId            String
  taskDefinitionId   String?         @map("task_definition_id")
  title              String          // z.B. "Grill", "Kasse", "Ausschank / Bar"
  description        String?
  requiredSlots      Int             @default(1)
  minAge             Int?            // Mindestalter für diese Arbeit
  ageRequirementType String          @default("ALL") // "ALL" oder "AT_LEAST_ONE"
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  shift              Shift           @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  taskDefinition     TaskDefinition? @relation(fields: [taskDefinitionId], references: [id], onDelete: SetNull)
  signups            ShiftSignup[]

  @@map("shift_tasks")
}

model ShiftSignup {
  id          String     @id @default(uuid())
  shiftId     String
  taskId      String?
  userId      String?
  guestName   String?    // Cevi-Name oder Name bei passwortloser Anmeldung
  guestEmail  String?
  guestPhone  String?
  isConfirmed Boolean    @default(true)
  notes       String?
  /// Erinnerungs-Mail verschickt (oder vergeben, siehe services/shiftReminders.ts)
  reminderSentAt DateTime? @map("reminder_sent_at")
  /// Anwesenheit: null = offen, "PRESENT", "EXCUSED", "NO_SHOW"
  attendance       String?   @map("attendance")
  attendanceAt     DateTime? @map("attendance_at")
  /// "OK" (abgehakt) oder "QR" (Selbst-Check-in)
  attendanceSource String?   @map("attendance_source")
  attendanceByName String?   @map("attendance_by_name")
  createdAt   DateTime   @default(now())
  shift       Shift      @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  task        ShiftTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers     ShiftSignupAnswer[]

  @@map("shift_signups")
}

model EventTemplate {
  id                    String     @id @default(uuid())
  departmentId          String
  title                 String     // Name der Vorlage, z.B. "Chilbi Festzelt (3 Tage)"
  description           String?
  accessType            String     @default("PUBLIC") @map("access_type")
  leadersOnly           Boolean    @default(false) @map("leaders_only")
  requiredFields        String[]   @default([]) @map("required_fields")
  minShiftsPerPerson    Int?       @map("min_shifts_per_person")
  cancelDeadlineDays    Int?       @map("cancel_deadline_days")
  data                  Json       // Relative Struktur für Schichten und Arbeiten, dazu eigene Fragen und Zugangslisten
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  department            Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@map("event_templates")
}

// Abmeldung einer Person von einem Anlass: Person muss keine Schichten übernehmen (Soll entfällt)
model EventDeregistration {
  id          String   @id @default(uuid())
  eventId     String   @map("event_id")
  userId      String   @map("user_id")
  reason      String?  // Optional: z. B. «Im Militär», «Verletzt», «Ferien»
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by_id")
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_deregistrations")
}

model Upload {
  id        String   @id @default(uuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@map("uploads")
}

// Token zur Bestätigung der E-Mail-Adresse (z. B. nach Registrierung oder E-Mail-Änderung)
model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  email     String
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Link «Passwort vergessen»: gespeichert wird nur der SHA-256-Hash des Tokens
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model ShiftResponsible {
  id        String   @id @default(uuid())
  shiftId   String   @map("shift_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shiftId, userId])
  @@map("shift_responsibles")
}

model EventDayResponsible {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  dayDate   String   @map("day_date") // YYYY-MM-DD
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, dayDate, userId])
  @@map("event_day_responsibles")
}

// Protokoll aller Schicht-Eintragungen und -Austragungen
model ShiftSignupLog {
  id                String    @id @default(uuid())
  eventId           String    @map("event_id")
  shiftId           String?   @map("shift_id")
  action            String    // "SIGNUP", "SIGNOFF" oder "ATTENDANCE"
  helperUserId      String?   @map("helper_user_id")
  helperName        String    @map("helper_name")
  performedByUserId String?   @map("performed_by_user_id")
  performedByName   String?   @map("performed_by_name")
  shiftTitle        String    @map("shift_title")
  shiftStartTime    DateTime? @map("shift_start_time")
  shiftEndTime      DateTime? @map("shift_end_time")
  taskTitle         String?   @map("task_title")
  // Bei ATTENDANCE: neuer Status ("PRESENT", "EXCUSED", "NO_SHOW"), null = zurück auf offen
  attendance        String?   @map("attendance")
  createdAt         DateTime  @default(now()) @map("created_at")

  event             Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  shift             Shift?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  helperUser        User?     @relation("HelperUser", fields: [helperUserId], references: [id], onDelete: SetNull)
  performedByUser   User?     @relation("PerformedByUser", fields: [performedByUserId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@map("shift_signup_logs")
}

// Vom OK verschickte Nachrichten an Helfende (nur Verlauf, die Mails gehen einzeln raus)
model EventMessage {
  id             String   @id @default(uuid())
  eventId        String   @map("event_id")
  sentByUserId   String?  @map("sent_by_user_id")
  sentByName     String   @map("sent_by_name")
  subject        String
  body           String
  // "ALL", "SHIFTS", "PEOPLE" oder "OK"
  target         String
  targetLabel    String   @map("target_label")
  recipientCount Int      @map("recipient_count")
  failedCount    Int      @default(0) @map("failed_count")
  createdAt      DateTime @default(now()) @map("created_at")

  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@map("event_messages")
}

/// Protokoll aller Änderungen im Admin-Portal. Ohne Fremdschlüssel: Einträge bleiben, auch wenn
/// Admin, Person, Abteilung oder Anlass später gelöscht werden (Namen werden mitgespeichert).
model AdminAuditLog {
  id          String   @id @default(uuid())
  adminId     String?  @map("admin_id")
  adminName   String   @map("admin_name")
  // z. B. DEPARTMENT_DELETE, USER_ADMIN_GRANT, MEMBER_ROLE_SET
  action      String
  // USER, DEPARTMENT, EVENT
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  targetLabel String   @map("target_label")
  details     Json?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}
