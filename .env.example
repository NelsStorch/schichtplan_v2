# Domains
DOMAIN=cevi-schichtplan.ch
DOMAIN_DEV=dev.cevi-schichtplan.ch

# Database
DB_USER=cevi_schichtplan
DB_PASSWORD=dein-sicheres-passwort-hier
DB_NAME=cevi_schichtplan_v2

# Security
JWT_SECRET=mindestens-32-zeichen-langer-geheimer-schluessel-fuer-jwt
NODE_ENV=production

# Cevi.DB OAuth Provider (Empfohlen)
CEVIDB_BASE_URL=https://db.cevi.ch
CEVIDB_CLIENT_ID=
CEVIDB_CLIENT_SECRET=
CEVIDB_REDIRECT_URI=https://cevi-schichtplan.ch/api/auth/cevidb/callback

# Globale Admins (Zugriff auf admin.<domain>): Cevi.DB-Personen-IDs, kommagetrennt.
# Die ID steht in der Cevi.DB-Adresse der Person (.../people/<ID>). Wer sich mit Cevi.DB anmeldet, wird automatisch Admin.
GLOBAL_ADMIN_CEVIDB_IDS=

# Google OAuth Provider (Alternative)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://cevi-schichtplan.ch/api/auth/google/callback
